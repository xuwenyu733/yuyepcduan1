{
  "name": "yudao-ui-admin",
  "version": "2025.9.0-snapshot",
  "description": "养殖智慧平台",
  "author": "芋道",
  "license": "MIT",
  "scripts": {
    "local": "node scripts/local-with-api.js",
    "local:web": "node scripts/run-with-openssl.js vue-cli-service serve --mode local",
    "dev": "node scripts/run-with-openssl.js vue-cli-service serve --mode dev",
    "front": "vue-cli-service serve --mode front",
    "build:rtc": "bash ../scripts/build-rtc-static.sh",
    "build:prod": "node scripts/run-with-openssl.js vue-cli-service build --mode prod",
    "build:stage": "vue-cli-service build --mode stage",
    "build:dev": "node scripts/run-with-openssl.js vue-cli-service build --mode dev",
    "build:static": "vue-cli-service build --mode static",
    "preview": "node build/index.js --preview",
    "lint": "eslint --ext .js,.vue src",
    "test:rules": "node scripts/test-metric-rules.js",
    "clean": "rimraf node_modules",
    "modules-api": "npm --prefix services/modules-api start",
    "socket-server": "npm --prefix services/socket-server start",
    "modules-api:dev": "npm --prefix services/modules-api run dev",
    "modules-api:install": "npm --prefix services/modules-api install",
    "twin:install": "npm --prefix digital-twin install",
    "twin:build": "npm --prefix digital-twin run build",
    "twin:api": "npm --prefix digital-twin run api",
    "twin:dev": "npm --prefix digital-twin run web"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "src/**/*.{js,vue}": [
      "eslint --fix",
      "git add"
    ]
  },
  "keywords": [
    "vue",
    "admin",
    "dashboard",
    "element-ui",
    "boilerplate",
    "admin-template",
    "management-system"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/YunaiV/ruoyi-vue-pro"
  },
  "dependencies": {
    "@babel/parser": "7.18.4",
    "@riophae/vue-treeselect": "0.4.0",
    "axios": "0.27.2",
    "benz-amr-recorder": "^1.1.5",
    "bignumber.js": "^9.3.1",
    "bpmn-js-token-simulation": "0.10.0",
    "clipboard": "2.0.8",
