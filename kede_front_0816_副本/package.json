    "svg-sprite-loader": "5.1.1",
    "terser-webpack-plugin": "^4.2.3",
    "webpack-bundle-analyzer": "^3.9.0",
    "yorkie": "^2.0.0"
  },
  "engines": {
    "node": ">=14.17.0 <21",
    "npm": ">=6.0.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions"
  ]
}
