VUE_APP_FUNASR_H5 = 'https://t3.kdaqua.com/#/voice2txt'
# 本地开发远程 ASR 常 502，默认关闭自动连接；需要语音识别时改为 true 并确保代理可达
VUE_APP_FUNASR_ENABLE = false
VUE_APP_FUNASR_SOCKET = 'wss://lanproxy.kdaqua.com/proxy50000/'
# VUE_APP_FUNASR_H5 = 'http://localhost:4994/#/voice2txt'
