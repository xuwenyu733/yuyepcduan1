# 视频通话、语音通话 websocket 地址
VUE_APP_SOCKET_BACE_URL = 'ws://localhost:9091'

# 租户功能
VUE_APP_TENANT_ENABLE = true
VUE_APP_DOC_ENABLE = true

# 验证码的开关
VUE_APP_CAPTCHA_ENABLE = false

# 默认的登录账号密码，方便你快速测试
