# 科德基地总控服务平台/开发环境（连本地后端）
VUE_APP_ROOT_API = 'http://127.0.0.1:48181'
#VUE_APP_ROOT_API = 'http://4be43f4b.r5.cpolar.top'
VUE_APP_BASE_API = '/proxy-api'
VUE_APP_WEBSOCKET_API = 'ws://127.0.0.1:48181'
# 三模块 BFF：走同源 /modules-api（vue.config 代理到 :3020）；勿写死 localhost，远程会打到浏览器本机
VUE_APP_MODULES_API = /modules-api
# 本地 PMIS：仅 /wiidu-datainf 代理用（值为 .../zx/datainf）
VUE_APP_PMIS_PROXY_TARGET = http://127.0.0.1:8088/zx/datainf
