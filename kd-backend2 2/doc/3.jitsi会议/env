# 基础配置
CONFIG=/data/jitsi_data/jitsi
HTTP_PORT=80
HTTPS_PORT=443
TZ=Asia/Shanghai

# 公共 URL（必须使用 HTTPS）
PUBLIC_URL= https://t4.kedeyuye.online

# Docker 主机地址（使用服务器内网 IP 或公网 IP）
DOCKER_HOST_ADDRESS=172.21.0.11  # 替换为你的服务器 IP

# 禁用 Let's Encrypt（因为我们使用自己的证书）
ENABLE_LETSENCRYPT=0
DISABLE_HTTPS=0  # 启用 HTTPS
ENABLE_HTTP_REDIRECT=1  # 启用 HTTP 到 HTTPS 重定向

# 启用文件共享
ENABLE_FILE_SHARING=true
ENABLE_FILE_SHARING_UPLOAD=true
FILE_SHARING_UPLOAD_URL= https://t4.kedeyuye.online/upload

# 启用会议录制
ENABLE_RECORDING=1

# 关闭 WebSocket（可选，根据需求）
ENABLE_SCTP=1
ENABLE_COLIBRI_WEBSOCKET=1
ENABLE_XMPP_WEBSOCKET=0
COLABRI_WEBSOCKET_REGEX=".*"
COLIBRI_WEBSOCKET_PORT=443

