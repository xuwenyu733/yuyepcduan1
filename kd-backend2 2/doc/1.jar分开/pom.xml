                        </include>
                        <include>
                            <groupId>cn.iocoder.boot</groupId>
                            <artifactId>yudao-module-system</artifactId>
                        </include>
                        <include>
                            <groupId>cn.iocoder.boot</groupId>
                            <artifactId>yudao-spring-boot-starter-biz-data-permission</artifactId>
                        </include>
                        <include>
                            <groupId>cn.iocoder.boot</groupId>
                            <artifactId>yudao-spring-boot-starter-biz-ip</artifactId>
                        </include>
                        <include>
                            <groupId>cn.iocoder.boot</groupId>
                            <artifactId>yudao-spring-boot-starter-biz-tenant</artifactId>
                        </include>
                        <include>
                            <groupId>cn.iocoder.boot</groupId>
                            <artifactId>yudao-spring-boot-starter-excel</artifactId>
                        </include>
                        <include>
                            <groupId>cn.iocoder.boot</groupId>
                            <artifactId>yudao-spring-boot-starter-job</artifactId>
                        </include>
                        <include>
                            <groupId>cn.iocoder.boot</groupId>
                            <artifactId>yudao-spring-boot-starter-monitor</artifactId>
                        </include>
                        <include>
                            <groupId>cn.iocoder.boot</groupId>
                            <artifactId>yudao-spring-boot-starter-mq</artifactId>
                        </include>
                        <include>
                            <groupId>cn.iocoder.boot</groupId>
                            <artifactId>yudao-spring-boot-starter-mybatis</artifactId>
                        </include>
                        <include>
                            <groupId>cn.iocoder.boot</groupId>
                            <artifactId>yudao-spring-boot-starter-protection</artifactId>
                        </include>
                        <include>
                            <groupId>cn.iocoder.boot</groupId>
                            <artifactId>yudao-spring-boot-starter-redis</artifactId>
                        </include>
                        <include>
                            <groupId>cn.iocoder.boot</groupId>
                            <artifactId>yudao-spring-boot-starter-security</artifactId>
                        </include>
                        <include>
                            <groupId>cn.iocoder.boot</groupId>
                            <artifactId>yudao-spring-boot-starter-web</artifactId>
                        </include>
                        <include>
                            <groupId>cn.iocoder.boot</groupId>
                            <artifactId>yudao-spring-boot-starter-websocket</artifactId>
                        </include>
                    </includes>
                </configuration>
            </plugin>
            <!--拷贝第三方依赖文件到指定目录-->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-dependencies</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <!--target/libs是依赖jar包的输出目录，根据自己喜好配置-->
                            <outputDirectory>target/libs</outputDirectory>
                            <excludeTransitive>false</excludeTransitive>
                            <stripVersion>false</stripVersion>
                            <includeScope>runtime</includeScope>
                            <!-- 不拷贝的依赖 -->
                            <excludeArtifactIds>activiti-spring,activiti-engine,yudao-common,yudao-module-bpm,yudao-module-erp,yudao-module-fish,yudao-module-infra,yudao-module-system,yudao-spring-boot-starter-biz-data-permission,yudao-spring-boot-starter-biz-ip,yudao-spring-boot-starter-biz-tenant,yudao-spring-boot-starter-excel,yudao-spring-boot-starter-job,yudao-spring-boot-starter-monitor,yudao-spring-boot-starter-mq,yudao-spring-boot-starter-mybatis,yudao-spring-boot-starter-protection,yudao-spring-boot-starter-redis,yudao-spring-boot-starter-security,yudao-spring-boot-starter-web,yudao-spring-boot-starter-websocket,</excludeArtifactIds>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
        <!--将mapper文件打包进去-->
        <resources>
            <resource>
                <!--指定根目录 到源文件夹 一般如下-->
                <directory>src/main/java</directory>
                <includes>
                    <include>**/*.*</include>
                </includes>
                <filtering>false</filtering>
            </resource>
            <resource>
                <!--指定根目录 到源文件夹 一般如下-->
                <directory>src/main/resources</directory>
                <includes>
                    <include>**/*.*</include>
                </includes>
                <filtering>false</filtering>
            </resource>
        </resources>
        <!-- 设置构建的 jar 包名 -->
        <finalName>${project.artifactId}</finalName>
    </build>

